# Copy to .env (git-ignored). Never commit real values.

# PostgreSQL. This default matches `npm run db:start` (local development only).
DATABASE_URL=postgresql://supersave:supersave@localhost:54329/supersave

# Protects /admin and the manual-import API. Required in production; if it is unset
# in production the admin area is disabled.
ADMIN_TOKEN=

# Hours after which a price is shown as STALE rather than VERIFIED.
PRICE_STALE_AFTER_HOURS=48

# Python command the admin "manual import" button runs (py on Windows, python3 elsewhere).
PYTHON_BIN=py
